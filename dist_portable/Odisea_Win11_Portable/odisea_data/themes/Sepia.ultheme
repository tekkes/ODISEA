        "border-color": "#30b0c7"
      },
      "list-unordered": {
        "markup-color": "#ff9500",
        "font-color": "#1d1d1f"
      },
      "list-ordered": {
        "markup-color": "#ff9500",
        "font-color": "#1d1d1f"
      },
      "list-task": {
        "markup-color": "#34c759",
        "font-color": "#1d1d1f",
        "completed-color": "#8e8e93"
      },
      "divider": {
        "markup-color": "#d2d2d7",
