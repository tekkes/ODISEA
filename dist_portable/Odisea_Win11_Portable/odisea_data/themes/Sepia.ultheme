{
  "themeVersion": 1,
  "name": "Sepia Pergamino Editorial",
  "author": "Odisea Architecture Team",
  "palette": {
    "accents": {
      "accent-red": "#ff3b30",
      "accent-orange": "#ff9500",
      "accent-yellow": "#ffcc00",
      "accent-green": "#34c759",
      "accent-teal": "#30b0c7",
      "accent-blue": "#007aff",
      "accent-indigo": "#5856d6",
      "accent-purple": "#af52de",
      "accent-pink": "#ff2d55",
      "accent-brown": "#a2845e",
      "accent-gray": "#8e8e93"
    }
  },
  "light": {
    "editor": {
      "background-color": "#f4ecd8",
      "font-color": "#433422",
      "insertion-point-color": "#a0522d",
      "selection-color": "#ded2b7",
      "current-line-color": "#efe6d0"
    },
    "markup": {
      "heading-1": {
        "font-color": "#1d1d1f",
        "font-weight": "bold",
        "font-size-scale": 1.7,
        "markup-color": "#007aff"
      },
      "heading-2": {
        "font-color": "#1d1d1f",
        "font-weight": "bold",
        "font-size-scale": 1.4,
        "markup-color": "#007aff"
      },
      "heading-3": {
        "font-color": "#1d1d1f",
        "font-weight": "bold",
        "font-size-scale": 1.2,
        "markup-color": "#007aff"
      },
      "heading-4": {
        "font-color": "#1d1d1f",
        "font-weight": "semibold",
        "font-size-scale": 1.1,
        "markup-color": "#5856d6"
      },
      "heading-5": {
        "font-color": "#3a3a3c",
        "font-weight": "medium",
        "font-style": "italic",
        "font-size-scale": 1.0,
        "markup-color": "#5856d6"
      },
      "heading-6": {
        "font-color": "#6e6e73",
        "font-weight": "semibold",
        "font-size-scale": 0.9,
        "markup-color": "#8e8e93"
      },
      "paragraph": {
        "font-color": "#1d1d1f"
      },
      "block-quote": {
        "font-color": "#3a3a3c",
        "font-style": "italic",
